# Discord webhook URL for notifications
# Create at: Discord Server Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=

# Notification cooldown in seconds (default: 30)
NOTIFICATION_COOLDOWN=30

# AI confidence threshold (default: 0.5)
CONFIDENCE_THRESHOLD=0.5

# Motion detection sensitivity 1-255 (default: 25)
MOTION_SENSITIVITY=25

# Motion threshold percentage (default: 1.5)
MOTION_THRESHOLD_PERCENT=1.5

# Frame capture interval in seconds (default: 2.0)
CAPTURE_INTERVAL=2.0
